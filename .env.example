# Neon pooled connection string.
# Ingest uses the `ingest` role; the web app uses the lower-privilege `web` role.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&application_name=ingest

# Shared secret for POST /api/revalidate (generate: openssl rand -base64 32)
REVALIDATE_SECRET=

# HTTP Basic password for the site (phase 3)
APP_PASSWORD=
